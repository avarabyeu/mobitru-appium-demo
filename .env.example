# ===========================
# Execution Mode
# ===========================
# Options: local, remote
EXECUTION_MODE=local

# ===========================
# Local Execution Settings
# ===========================
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ===========================
# Device Configuration
# ===========================
PLATFORM_NAME=Android
AUTOMATION_NAME=UiAutomator2
DEVICE_NAME=Android Emulator
UDID=

# ===========================
# Application Configuration
# ===========================
APP_PACKAGE=com.epam.mobitru
APP_ACTIVITY=com.epam.mobitru.MainActivity
APP_PATH=
NO_RESET=true

# ===========================
# Remote Device Farm Settings
# ===========================
DEVICE_FARM_BASE_URL=app.mobitru.com
DEVICE_FARM_BROWSER_HUB_BASE_URL=
DEVICE_FARM_API_KEY=
DEVICE_FARM_SLUG=
DEVICE_FARM_UDID=
DEVICE_FARM_APP_ID=

# ===========================
# Network/Security Settings
# ===========================
# Set to 0 to disable TLS certificate validation (for dev/stage environments)
NODE_TLS_REJECT_UNAUTHORIZED=1

# ===========================
# Test Settings
# ===========================
LOG_LEVEL=info
MAX_INSTANCES=1

# Timeout Configuration (milliseconds)
WAITFOR_TIMEOUT=10000
CONNECTION_RETRY_TIMEOUT=120000
CONNECTION_RETRY_COUNT=3
